{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:investigation": "node --experimental-strip-types --import ./test-support/loader.mjs --test src/aml/investigation-output.test.mjs",
    "test:technical": "node --experimental-strip-types --import ./test-support/loader.mjs --test src/aml/technical.test.mjs",
    "test:golden": "node --experimental-strip-types --import ./test-support/loader.mjs --test src/aml/golden-cases.test.mjs",
    "test:identity": "node --experimental-strip-types --import ./test-support/loader.mjs --test src/aml/identity.test.mjs",
    "test:sanctions": "node --experimental-strip-types --import ./test-support/loader.mjs --test src/aml/sanctions.test.mjs",
    "test": "pnpm run test:technical && pnpm run test:investigation && pnpm run test:golden && pnpm run test:identity && pnpm run test:sanctions",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-anthropic-ai": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.5.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "catalog:",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
